# Copy this file's contents into Vercel → Project → Settings → Environment Variables.
# Never commit a real .env.local with these values filled in.

# WhatsApp button (already in use)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase project settings → API
# Both of these are safe to expose in the browser — Row Level Security
# (see supabase/migrations/0001_init_schema.sql) is what actually
# protects the data, not secrecy of these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOT NEEDED YET. Only add this later, server-side only (no
# NEXT_PUBLIC_ prefix), if a future feature needs to bypass RLS from
# a server route — e.g. an admin bulk-import tool. Never put this in
# client code or commit it.
# SUPABASE_SERVICE_ROLE_KEY=
